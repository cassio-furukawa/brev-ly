{
  "name": "brevly-server",
  "version": "1.0.0",
  "description": "API para encurtamento de URLs",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.1",
    "fast-csv": "^5.0.1",
    "fastify": "^5.0.0",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "drizzle-kit": "^0.27.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
